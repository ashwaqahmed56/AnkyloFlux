{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ankylo",
  "version": "0.1.0",
  "identifier": "dev.ankylo.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1488",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ankylo",
        "width": 1360,
        "height": 800,
        "minWidth": 880,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0e1013"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": [
      "binaries/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}